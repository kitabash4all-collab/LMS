# ─────────────────────────────────────────────────────────────
# Kitabash environment. Copy this file to `.env` and fill in.
# `.env` is git-ignored — NEVER commit real keys or passwords.
# Everything is optional: with nothing set, Kitabash runs on a
# local SQLite file with local file storage and the offline tutor.
# ─────────────────────────────────────────────────────────────

PORT=3000
# Long random string used to sign sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Local data (SQLite file + uploads when not using Supabase)
DATA_DIR=./data

# ── Supabase: database ──────────────────────────────────────
# Supabase dashboard → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password. If the password contains
# special characters (@ : / # ? % space), URL-encode them (e.g. # → %23).
# Keep ?sslmode=require on the end.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Optional: number of pooled connections (Supabase free tier: keep it small)
DATABASE_POOL_SIZE=5
# Optional: path to a CA certificate when using sslmode=verify-full
DATABASE_CA_CERT=

# ── Supabase: file storage (optional) ───────────────────────
# Supabase dashboard → Project Settings → API. When both are set, uploaded
# knowledge files and media go to a PRIVATE bucket instead of local disk.
# The service-role key is a server secret — never put it in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kitabash
# Force a driver: local | supabase (default: supabase when the two values above are set)
STORAGE_DRIVER=

# ── AI provider (optional) ──────────────────────────────────
# mock (default, offline rule-based tutor) | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_OUTPUT_TOKENS=1500
AI_LOG_RETENTION_DAYS=90
# Class recordings (audit): deleted after this many days; size cap for one recording
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_MB=1500

# ── Other integrations (status shown in Admin → Platform → Integrations)
SPEECH_TO_TEXT_API_KEY=
OCR_API_KEY=

# ── Public website & leads ──────────────────────────────────
# The marketing site is shown at "/" to visitors who are not signed in.
# Your full site address, used in links inside emails and WhatsApp messages.
PUBLIC_URL=
# Your WhatsApp Business number (digits with country code). Shows a "Chat on WhatsApp" button on the site.
PUBLIC_WHATSAPP_NUMBER=
# Where to email an alert for every new website enquiry (optional).
LEAD_ALERT_EMAIL=
# Country code added to 10-digit phone numbers (91 = India).
DEFAULT_COUNTRY_CODE=91

# ── Email: weekly parent reports and lead alerts ────────────
# brevo | resend  (both have free tiers). Nothing is sent until this is set.
EMAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
# A sender on a domain you have verified with the provider.
EMAIL_FROM=Kitabash <hello@your-domain.com>

# ── WhatsApp ────────────────────────────────────────────────
# manual (default): the portal writes each message (lead welcomes, weekly reports) and lists it
#   under Admin → Platform → Messages & reports. You tap "Open in WhatsApp" and press Send from
#   your normal WhatsApp account. Nothing is sent automatically, so your number is never at risk.
# chatdaddy: sends automatically through ChatDaddy. Build one message flow per message type using
#   these parameters, and put each flow's id (bot_...) below. Types without a flow use the queue.
#     lead_trial / lead_teacher / lead_school: {{name}} {{interest}} {{childAge}}
#     weekly_report: {{parentName}} {{childName}} {{summary}} {{link}}
# off: no WhatsApp at all.
# Messages go only to people who opted in.
WHATSAPP_PROVIDER=manual
CHATDADDY_API_TOKEN=
CHATDADDY_ACCOUNT_ID=
CHATDADDY_BOT_LEAD_TRIAL=
CHATDADDY_BOT_LEAD_TEACHER=
CHATDADDY_BOT_LEAD_SCHOOL=
CHATDADDY_BOT_WEEKLY_REPORT=

# ── Weekly parent reports ───────────────────────────────────
# Made every Sunday from this hour (India time). WEEKLY_REPORTS=off stops them.
REPORT_HOUR_IST=18
WEEKLY_REPORTS=on

# ── Live classes (optional) ─────────────────────────────────
# Video/audio go browser-to-browser (WebRTC). Public STUN works for most homes;
# add a TURN relay for strict school/mobile networks. Run ONE server instance.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Max people in a class, including the teacher
LIVE_MAX_PARTICIPANTS=12
